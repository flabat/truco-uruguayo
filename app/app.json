{
  "expo": {
    "name": "El Truco",
    "slug": "el-truco",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "eltruco",
    "userInterfaceStyle": "light",
    "backgroundColor": "#faf8f0",
    "icon": "./assets/icono/ios.png",
    "ios": {
      "bundleIdentifier": "co.eltru.app",
      "supportsTablet": true,
      "icon": "./assets/icono/ios.png"
    },
    "android": {
      "package": "co.eltru.app",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icono/android-frente.png",
        "backgroundImage": "./assets/icono/android-fondo.png",
        "monochromeImage": "./assets/icono/android-monocromo.png",
        "backgroundColor": "#1c392d"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "single",
      "name": "El Truco",
      "lang": "es-UY",
      "backgroundColor": "#faf8f0",
      "themeColor": "#233d31",
      "favicon": "./assets/icono/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icono/inicio.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#faf8f0"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/app"
    }
  }
}
