{
  "expo": {
    "name": "El Truco",
    "slug": "el-truco",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "eltruco",
    "userInterfaceStyle": "light",
    "backgroundColor": "#faf8f0",
    "ios": {
      "bundleIdentifier": "co.eltru.app",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:eltru.co"
      ]
    },
    "android": {
      "package": "co.eltru.app",
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "eltru.co",
              "path": "/jugar"
            },
            {
              "scheme": "https",
              "host": "eltru.co",
              "pathPrefix": "/jugar/"
            },
            {
              "scheme": "https",
              "host": "eltru.co",
              "path": "/volver"
            },
            {
              "scheme": "https",
              "host": "eltru.co",
              "pathPrefix": "/volver/"
            },
            {
              "scheme": "https",
              "host": "eltru.co",
              "path": "/app"
            },
            {
              "scheme": "https",
              "host": "eltru.co",
              "pathPrefix": "/app/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "single",
      "name": "El Truco",
      "lang": "es-UY",
      "backgroundColor": "#faf8f0",
      "themeColor": "#233d31"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#faf8f0"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/app"
    }
  }
}
