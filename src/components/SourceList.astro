---
import Icon from "./Icon.astro";
import type { Source } from "../lib/guide";
interface Props {
  sources: Source[];
}
const { sources } = Astro.props;
---

<ul class="source-links">
  {sources.map((source) => (
    <li>
      <a href={source.url}>
        {source.title}
        <Icon name="external" size={13} />
      </a>
    </li>
  ))}
</ul>
