---
import Muestra from "../Muestra.astro";
import Icon from "../Icon.astro";
import { url } from "../../lib/guide";
---
<section id="practica" class="shell ap-practica" hidden aria-labelledby="titulo-practica">
  <a data-ruta class="quiet-link ap-volver" href={url("aprender/")}><span aria-hidden="true">←</span> Todos los temas</a>
  <header>
    <p id="modo" class="eyebrow"></p>
    <h1 id="titulo-practica" tabindex="-1"></h1>
  </header>
  <div class="ap-ejercicio">
    <div class="ap-cabecera">
      <p id="etapa" class="eyebrow"></p>
      <h2 id="consigna" tabindex="-1"></h2>
      <p id="instruccion"></p>
      <div class="ap-acciones ap-acciones-ejemplo">
        <button id="ir-a-practicar" class="button" type="button" hidden>Ir a practicar</button>
        <button id="repetir-demostracion" class="quiet-link ap-link" type="button" hidden><Icon name="turn" size={16} /> Repetir demostración</button>
      </div>
    </div>
    <div class="ap-mesa">
      <template id="gesto-demostracion">
        <svg class="ap-gesto" aria-hidden="true" viewBox="0 0 48 48" width="48" height="48">
          <circle cx="13" cy="13" r="10" fill="none" stroke="#fff6d6" stroke-width="3" />
          <path d="m13 13 3 25 6-7 7 11 6-4-7-10 10-2z" fill="#fff6d6" stroke="#263b30" stroke-width="2.5" stroke-linejoin="round" />
        </svg>
      </template>
      <div class="ap-muestra">
        <Muestra id="carta-muestra" />
      </div>
      <div class="ap-mano">
        <h3 id="rotulo-mano">Cartas de la mano</h3>
        <div id="cartas-mano" role="group" aria-labelledby="rotulo-mano"></div>
        <span id="empate-demostracion" class="ap-opcion ap-empate" hidden>Empatan</span>
      </div>
    </div>
    <div class="ap-respuesta">
      <div id="opciones" class="ap-acciones"></div>
      <form id="cuenta" hidden>
        <label for="tantos">Tu total</label>
        <div><input id="tantos" name="tantos" type="number" min="0" max="9007199254740991" step="1" inputmode="numeric" required/><button class="button">Comprobar total</button></div>
      </form>
      <p id="ejemplo-resuelto" hidden></p>
      <div id="feedback" role="status" aria-live="polite" aria-atomic="true"></div>
      <div id="continuacion" class="ap-acciones"></div>
    </div>
  </div>
  <details class="ap-consulta">
    <summary>Regla para esta mano <small id="aviso-consulta" hidden>(cuenta como ayuda)</small></summary>
    <p id="regla"></p>
    <a id="capitulo" class="text-link" target="_blank" rel="noopener">Leer el capítulo completo en otra pestaña <Icon name="arrow" size={15}/></a>
  </details>
  <p id="avance-actual"></p>
</section>
