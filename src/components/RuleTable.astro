---
import type { Table } from "../lib/guide";
interface Props {
  table: Table;
}
const { table } = Astro.props;
---

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        {table.headers.map((header) => (
          <th scope="col">{header}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {table.rows.map((row) => (
        <tr>
          {row.map((value, i) => (i === 0 ? <th scope="row">{value}</th> : <td>{value}</td>))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
