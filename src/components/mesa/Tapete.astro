---
import Muestra from "../Muestra.astro";
import { asientos } from "./relato";
---
<section class="tapete" aria-labelledby="estado-tapete">
  <header class="tapete-cabecera"><h2 id="estado-tapete"></h2><span id="turno-mesa"></span></header>
  <div class="tapete-asientos">
    {asientos.map((nombre, i) => (
      <div class={`asiento asiento-${i}`} role="group" aria-label={nombre}>
        <div class="asiento-nombre">
          <h3>{nombre}</h3>
          <span class="asiento-papel"></span>
        </div>
        {i === 0 ? (
          <div class="asiento-cartas">
            <div class="mesa-naipes" id="mis-cartas" role="group" aria-label="Tus cartas"></div>
            <div class="mesa-jugada" hidden>
              <small>Jugada</small>
              <div class="cartas-vuelta"></div>
            </div>
          </div>
        ) : <div class="asiento-cartas cartas-vuelta"></div>}
      </div>
    ))}
    <div class="tapete-muestra">
      <Muestra id="muestra" />
    </div>
  </div>
</section>
