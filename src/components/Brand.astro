---
import { url } from "../lib/guide";
---

<a href={url()} class="brand" aria-label="Truco Oriental, inicio">
  <svg width="32" height="36" viewBox="0 0 35 40" aria-hidden="true" fill="none">
    <g transform="rotate(-20 13 24)">
      <rect
        x="3"
        y="7"
        width="19"
        height="28"
        rx="2.3"
        fill="var(--brand-paper, #faf7ef)"
        stroke="currentColor"
        stroke-width="1.65"
      />
    </g>
    <g transform="rotate(-6 16 22)">
      <rect
        x="8"
        y="5"
        width="19"
        height="28"
        rx="2.3"
        fill="var(--brand-paper, #faf7ef)"
        stroke="currentColor"
        stroke-width="1.65"
      />
    </g>
    <g transform="rotate(10 21 19)">
      <rect
        x="12"
        y="3"
        width="19"
        height="28"
        rx="2.3"
        fill="var(--brand-paper, #faf7ef)"
        stroke="currentColor"
        stroke-width="1.8"
      />
      <path d="m21.5 10 4.3 7-4.3 7-4.3-7z" fill="currentColor" />
      <path d="m15 6 1.2 1.9L15 10l-1.2-2.1zm13 19 1.2 1.9-1.2 2.1-1.2-2.1z" fill="currentColor" />
