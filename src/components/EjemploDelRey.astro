---
import Carta from "./Carta.astro";
import { url } from "../lib/guide";
import { cartasPorId } from "../lib/cartas";
---
<div class="mesa" role="group" aria-label="Ejemplo con el 4 de copas de muestra">
  <div class="reparto">
    <div class="mazo">
      <div class="dorso"><Carta id="reverso" /></div>
      <Carta id="copas-04" decorativa />
    </div>
    <div>
      <span class="rotulo">Muestra</span>
      <strong>4 de copas</strong>
    </div>
  </div>
  <span class="rotulo" id="orden-del-ejemplo">De mayor a menor fuerza</span>
  <ol class="jugadas" aria-labelledby="orden-del-ejemplo">
    {["copas-12", "copas-05", "espadas-01"].map((id) => (
      <li>
        <Carta id={id} decorativa />
        <span>{cartasPorId.get(id)!.nombre}</span>
      </li>
    ))}
  </ol>
</div>
<a class="text-link ver-baraja" href={url("baraja/")}>Ver la baraja completa →</a>
<style>
  .ver-baraja { margin-top: 14px; }
  .mesa {
    margin: 1.25rem 0 0;
    padding: clamp(16px, 3.5vw, 28px);
    max-width: 560px;
    background: var(--ink);
    color: var(--paper);
    border-radius: 6px;
  }
  .reparto {
    display: flex;
    align-items: center;
    gap: 20px;
    padding-bottom: 16px;
    margin-bottom: 15px;
    border-bottom: 1px solid rgb(250 248 240 / 25%);
  }
  .mazo {
    --ancho-carta: clamp(72px, 20vw, 104px);
    display: grid;
    place-items: end center;
    isolation: isolate;
  }
  .mazo > :global(*) { grid-area: 1 / 1; }
  .mazo :global(img) { width: var(--ancho-carta); }
  .dorso {
    z-index: 1;
    display: grid;
    place-content: center;
    width: calc(var(--ancho-carta) * 596 / 384);
    height: var(--ancho-carta);
  }
  .dorso :global(img) { transform: rotate(90deg); }
  .rotulo {
    display: block;
    color: #ded5b7;
    font-size: 0.73rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .reparto strong {
    display: block;
    margin-top: 3px;
    font: 400 clamp(23px, 5vw, 30px) var(--serif);
  }
  .jugadas {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(8px, 2.5vw, 22px);
    list-style: none;
    padding: 0;
    margin: 12px 0 0;
  }
  .mesa .jugadas li {
    margin: 0;
    padding: 0;
    color: inherit;
    font-size: 0.82rem;
    line-height: 1.3;
    font-weight: 600;
    text-align: center;
  }
  .jugadas span { display: block; margin-top: 8px; }
</style>
