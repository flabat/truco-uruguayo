---
import Carta from "./Carta.astro";
import Muestra from "./Muestra.astro";
import { url } from "../lib/guide";
import { cartasPorId } from "../lib/cartas";
---
<div class="mesa">
  <div class="reparto">
    <Muestra id="muestra-rey" carta="copas-04" />
  </div>
  <span class="rotulo" id="orden-del-ejemplo">De mayor a menor fuerza</span>
  <ol class="jugadas" aria-labelledby="orden-del-ejemplo">
    {["copas-12", "copas-05", "espadas-01"].map((id) => (
      <li>
        <Carta id={id} decorativa />
        <span>{cartasPorId.get(id)!.nombre}</span>
      </li>
    ))}
  </ol>
</div>
<a class="text-link ver-baraja" href={url("baraja/")}>Ver la baraja completa →</a>
<style>
  .ver-baraja { margin-top: 14px; }
  .mesa {
    margin: 1.25rem 0 0;
    padding: clamp(16px, 3.5vw, 28px);
    max-width: 560px;
    background: var(--ink);
    color: var(--paper);
    border-radius: 6px;
  }
  .reparto {
    --direccion-muestra: row;
    --alineacion-muestra: left;
    --espacio-muestra: 20px;
    --fuente-muestra: 400 clamp(23px, 5vw, 30px)/1.15 var(--serif);
    --ancho-mazo: clamp(112px, 31vw, 161px);
    padding-bottom: 16px;
    margin-bottom: 15px;
    border-bottom: 1px solid rgb(250 248 240 / 25%);
  }
  .rotulo {
    display: block;
    color: #ded5b7;
    font-size: 0.73rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .jugadas {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(8px, 2.5vw, 22px);
    list-style: none;
    padding: 0;
    margin: 12px 0 0;
  }
  .mesa .jugadas li {
    margin: 0;
    padding: 0;
    color: inherit;
    font-size: 0.82rem;
    line-height: 1.3;
    font-weight: 600;
    text-align: center;
  }
  .jugadas span { display: block; margin-top: 8px; }
</style>
