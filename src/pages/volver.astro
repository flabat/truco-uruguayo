---
import Site from "../layouts/Site.astro";
---
<Site active="jugar" title="Volver a la mesa" description="Retomá tu asiento o mirá la partida desde el salón.">
  <article class="shell">
    <h1>Volver a la mesa</h1>
    <p role="status" id="regreso-estado">Buscando tu mesa…</p>
    <a id="regreso-reintentar" hidden>Reintentar</a>
    <a href="/jugar/">Ir al juego</a>
    <noscript>Activá JavaScript para abrir esta mesa.</noscript>
  </article>
</Site>

<script>
  async function regresar() {
    const id = new URLSearchParams(location.search).get("mesa");
    const estado = document.querySelector<HTMLElement>("#regreso-estado")!;
    if (!id || !/^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$/i.test(id)) {
      estado.textContent = "El enlace a la mesa es inválido.";
      return;
    }
    const acceso = (ruta: string) => fetch(ruta, { cache: "no-store", signal: AbortSignal.timeout(10000) });
    try {
      const asiento = await acceso("/api/mesas/" + id);
      let respuesta = asiento;
      let modo = "mesa";
      if (asiento.status === 404) {
        modo = "mirar";
        respuesta = await acceso("/api/salon/mesas/" + id);
      }
      if (respuesta.status === 401) {
        location.replace("/api/auth/login?" + new URLSearchParams({ volver: "/volver/?mesa=" + id }));
      } else if (respuesta.status === 404 || respuesta.status === 403 || respuesta.status === 410) {
        estado.textContent = "Esta mesa no está disponible para mirar.";
      } else if (respuesta.ok && respuesta.headers.get("content-type")?.includes("application/json")) {
        location.replace("/jugar/?" + new URLSearchParams({ [modo]: id }));
      } else {
        throw new Error("Respuesta inesperada");
      }
    } catch {
      estado.textContent = "No pudimos consultar la mesa.";
      const reintento = document.querySelector<HTMLAnchorElement>("#regreso-reintentar")!;
      reintento.href = "/volver/?mesa=" + id;
      reintento.hidden = false;
    }
  }
  void regresar();
</script>
