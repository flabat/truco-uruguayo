---
import Site from "../../layouts/Site.astro";
import Icon from "../../components/Icon.astro";
import { url } from "../../lib/guide";
import MesaGuiada from "../../components/mesa/MesaGuiada.astro";
import { textosProbabilidad } from "../../aprendizaje/probabilidad/escenas";
import "../../components/aprendizaje/aprender.css";
import "../../components/mesa/mesa.css";
---
<Site title="Mesa de parejas" description="Reconocé la flor, contá tus tantos y jugá una mano completa de truco uruguayo con tu compañero y dos rivales." active="aprender">
  <article class="shell guiada" data-base={url("")}>
    <header class="mesa-portada">
      <a class="quiet-link" href={url("aprender/")}><span aria-hidden="true">←</span> Volver a aprender</a>
      <h1>Mesa de <em>parejas</em></h1>
      <p>Jugás con el compañero de enfrente. Los otros tres asientos juegan sus propias cartas.</p>
    </header>
    <noscript><p>Activá JavaScript para jugar o <a class="text-link" href={url("reglas/bazas/")}>leé cómo se gana la mano</a>.</p></noscript>
    <div id="mesa-guiada" hidden>
      <MesaGuiada>
        <div id="consulta-chances" hidden>
          <button class="ap-link" type="button" id="comparar-mis-cartas" aria-expanded="false" aria-controls="panel-chances">Comparar mis cartas</button>
          <section id="panel-chances" aria-label="Probabilidad de ganar la mano" hidden>
            <p id="estado-chances" aria-live="polite" aria-atomic="true"></p>
            <div id="resultado-chances" hidden>
              <p id="metodo-chances"></p>
              <table>
                <caption>Chances de que tu pareja gane la mano</caption>
                <thead><tr><th scope="col">Carta</th><th scope="col">Chances</th><th scope="col">Manos ganadas</th></tr></thead>
                <tbody></tbody>
              </table>
              <details id="diferencias-chances">
                <summary>Cómo se calculó</summary>
                <p>{textosProbabilidad.informacion} {textosProbabilidad.politica}</p>
                <p id="explicacion-chances"></p>
                <ul></ul>
              </details>
            </div>
            <button id="reintentar-chances" class="ap-link" type="button" hidden>Volver a calcular</button>
            <a class="text-link" href={url("aprender/probabilidad/")}>Practicar la lección de probabilidad <Icon name="arrow" size={15}/></a>
          </section>
        </div>
        <a id="siguiente-leccion" class="text-link" href={url("aprender/truco/")} hidden>Siguiente lección · Cantar y responder al truco <Icon name="arrow" size={16}/></a>
        <form id="cuenta-mesa" hidden>
          <label for="total-mesa">Tu total</label>
          <div><input id="total-mesa" type="number" min="0" max="9007199254740991" step="1" required inputmode="numeric"/><button class="button">Comprobar total</button></div>
        </form>
        <p id="aviso-mesa" role="status" aria-atomic="true"></p>
        <button class="ap-link" id="pista-mesa" type="button">Pedir una pista</button>
      </MesaGuiada>
      <section class="mesa-historial" aria-labelledby="titulo-historial" hidden>
        <h2 id="titulo-historial">Vueltas jugadas</h2>
        <ol id="vueltas"></ol>
      </section>
      <details class="mesa-consulta">
        <summary>Consultar la regla <small id="aviso-consulta-mesa" hidden>(cuenta como ayuda)</small></summary>
        <p id="regla-mesa"></p>
        <a class="text-link" id="leer-regla" target="_blank" rel="noopener">Leer el capítulo completo en otra pestaña <Icon name="arrow" size={15}/></a>
      </details>
    </div>
  </article>
</Site>
<script>
  import { montarMesa } from "../../components/mesa/mesa";
  montarMesa();
</script>

<style>
  #panel-chances {
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  #panel-chances p, #panel-chances details { margin: 0 0 10px; }
  #panel-chances table { width: 100%; border-collapse: collapse; margin-block: 12px; }
  #panel-chances caption { text-align: left; margin-bottom: 6px; }
  #panel-chances th, #panel-chances :global(tbody th), #panel-chances :global(td) {
    text-align: left;
    padding: 4px;
    border-bottom: 1px solid var(--line);
    font-size: .875rem;
  }
  #panel-chances ul { padding-left: 1.25em; }
</style>
