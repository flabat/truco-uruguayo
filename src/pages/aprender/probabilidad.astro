---
import Site from "../../layouts/Site.astro";
import { url } from "../../lib/guide";
import Leccion from "../../components/probabilidad/Leccion";
import { escenas, textosProbabilidad } from "../../aprendizaje/probabilidad/escenas";
import { aperturaEditorial, referenciaEditorial } from "../../probabilidad/perfil";
import { presentarResultado } from "../../components/probabilidad/presentacion";
import "../../components/aprendizaje/aprender.css";
import "../../components/mesa/mesa.css";
import "../../components/probabilidad/probabilidad.css";
const apertura = presentarResultado(referenciaEditorial(aperturaEditorial)!, "referencia");
---
<Site title="Probabilidad en la mano" description="Compará las chances de ganar una mano de truco uruguayo jugando cada carta. Practicá dos decisiones y probá con otro reparto." active="aprender">
  <article class="shell guiada">
    <header class="mesa-portada">
      <a class="quiet-link" href={url("aprender/")}><span aria-hidden="true">←</span> Volver a aprender</a>
      <h1>Probabilidad en la <em>mano</em></h1>
      <p>{textosProbabilidad.objetivo}</p>
    </header>
    <Leccion base={url("")} client:load />
    <noscript>
      <style is:inline>.prob-interactiva { display: none }</style>
      <section class="prob-resultados">
        <h2>{escenas.salida.titulo}</h2>
        <p>{escenas.salida.consigna}</p>
        <table>
          <caption>Manos ganadas por tu pareja en los mismos {apertura.denominador}</caption>
          <thead><tr><th scope="col">Carta</th><th scope="col">Probabilidad</th><th scope="col">Victorias</th></tr></thead>
          <tbody>{apertura.filas.map(fila => <tr>
            <th scope="row">{fila.nombre}</th><td>{fila.porcentaje}</td><td>{fila.victorias}</td>
          </tr>)}</tbody>
        </table>
        <p>{escenas.salida.explicacion} {textosProbabilidad.politica}</p>
        <p>Activá JavaScript para comparar durante la mano, jugar una carta y repasar cada decisión.</p>
      </section>
    </noscript>
  </article>
</Site>
