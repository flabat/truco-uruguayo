---
import Site from "../../layouts/Site.astro";
import { url } from "../../lib/guide";
import Tapete from "../../components/mesa/Tapete.astro";
import "../../components/aprendizaje/aprender.css";
import "../../components/mesa/mesa.css";
---
<Site title="Cantar y responder al truco" description="Ofrecé jugar por dos, respondé un truco y comprobá quién cobra los tantos de la mano." active="aprender">
  <article class="shell guiada" data-base={url("")}>
    <header class="mesa-portada">
      <a class="quiet-link" href={url("aprender/mano/")}><span aria-hidden="true">←</span> Volver a la mano guiada</a>
      <h1>Cantar y responder al <em>truco</em></h1>
      <p>Nadie tiene flor. El envido ya se cobró. Ahora jugás por los tantos del truco.</p>
    </header>
    <noscript><p>Activá JavaScript para jugar o <a class="text-link" href={url("reglas/truco/")}>leé cómo se canta el truco</a>.</p></noscript>
    <div id="leccion-truco" hidden>
      <div class="mesa-columnas">
        <Tapete />
        <section class="mesa-panel" aria-labelledby="pregunta">
          <p class="eyebrow" id="momento"></p>
          <h2 id="pregunta" tabindex="-1" aria-describedby="guia-turno"></h2>
          <p id="guia-turno"></p>
          <div class="mesa-naipes" id="mis-cartas" role="group" aria-label="Tus cartas"></div>
          <div id="decisiones"></div>
        </section>
      </div>
      <details class="mesa-consulta" id="historial-truco">
        <summary>Ver cantos y cartas de la mano</summary>
        <p id="envido-cobrado"></p>
        <ol id="acciones-truco"></ol>
      </details>
      <a class="text-link" href={url("reglas/truco/")} target="_blank" rel="noopener">Leer las reglas del truco en otra pestaña</a>
    </div>
  </article>
</Site>
<script>
  import { montarLeccionTruco } from "../../components/mesa/leccion-truco";
  montarLeccionTruco();
</script>
