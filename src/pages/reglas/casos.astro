---
import Apendice from "../../layouts/Apendice.astro";
import Icon from "../../components/Icon.astro";
import RuleTable from "../../components/RuleTable.astro";
import { chapterNumber, examples, ruleUrl } from "../../lib/guide";
---

<Apendice
  id="casos"
  description="Manos resueltas del truco uruguayo: cómo pasar a buenas, quién cierra el chico, cuánto vale la falta y cómo se anota la contraflor."
  intro="Manos concretas resueltas con el reglamento. Cada caso enlaza al capítulo que lo explica."
>
  {examples.map((block) => (
    <section class="appendix-entry" id={block.id}>
      <p class="eyebrow">
        Capítulo {chapterNumber(block.rule.id)} · {block.rule.title}
      </p>
      <h2>{block.heading}</h2>
      <p>{block.text}</p>
      {block.table && <RuleTable table={block.table} />}
      <a class="text-link" href={ruleUrl(block.rule.id) + "#" + block.id}>
        Ver en el capítulo <Icon name="arrow" size={15} />
      </a>
    </section>
  ))}
</Apendice>
