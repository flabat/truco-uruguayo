---
import Brand from "../components/Brand.astro";
import Compartir from "../components/Compartir.astro";
import { discordComunidad } from "../lib/comunidad";
import FichaModelo from "../components/FichaModelo";
import Search from "../components/Search.astro";
import { url } from "../lib/guide";
import { nombreSitio } from "../lib/marca";
import { versionModeloPractica, versionMotorPractica } from "../probabilidad/perfil";
import "@fontsource/dm-sans/latin-400.css";
import "@fontsource/dm-sans/latin-500.css";
import "@fontsource/dm-sans/latin-600.css";
import "@fontsource/dm-sans/latin-700.css";
import "@fontsource/dm-serif-text/latin-400.css";
import "@fontsource/dm-serif-text/latin-400-italic.css";
import "../styles/site.css";
interface Props {
  title: string;
  description: string;
  active?: "inicio" | "aprender" | "reglas" | "fuentes";
}
const { title, description, active } = Astro.props;
const tituloPagina = title === nombreSitio ? nombreSitio : `${title} · ${nombreSitio}`;
const commit = import.meta.env.INTERFAZ_COMMIT;
// Las vistas previas son públicas y nunca contienen parámetros de invitación.
const canonica = new URL(Astro.url.pathname, Astro.site || "https://eltru.co");
const imagenSocial = new URL(url("img/mesa-social.jpg"), Astro.site || "https://eltru.co");
const pages = [
  { name: "Inicio", path: "", key: "inicio" },
  { name: "Jugar", path: "jugar/", key: "jugar" },
  { name: "Aprender", path: "aprender/", key: "aprender" },
  { name: "Reglas del Truco", path: "reglas/", key: "reglas" },
  { name: "Fuentes", path: "fuentes/", key: "fuentes" },
];
---

<!doctype html>
<html lang="es-UY">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="application-name" content={nombreSitio} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={nombreSitio} />
    <meta property="og:title" content={tituloPagina} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonica.href} />
    <meta property="og:image" content={imagenSocial.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloPagina} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagenSocial.href} />
    <meta name="theme-color" content="#f8f5eb" />
    <link rel="icon" type="image/svg+xml" href={url("favicon.svg")} />
    <link rel="apple-touch-icon" href={url("apple-touch-icon.png")} />
    {Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
    <title>{tituloPagina}</title>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#contenido">
      Saltar al contenido
    </a>
    <header class="masthead">
      <div class="shell masthead-inner">
        <Brand />
        <nav id="nav-principal" class="site-nav" aria-label="Navegación principal">
          {pages.map((page) => (
            <a href={url(page.path)} aria-current={active === page.key ? "page" : undefined}>
              {page.name}
            </a>
          ))}
        </nav>
        <Search />
      </div>
    </header>
    <main id="contenido">
      <slot />
      {(active === "inicio" || active === "aprender") && <div class="shell"><Compartir title={tituloPagina} description={description} /></div>}
    </main>
    <footer>
      <div class="shell footer-inner">
        <Brand />
        <p>Guía del truco uruguayo con muestra.</p>
        <a href={discordComunidad} data-discord-comunidad target="_blank" rel="noopener noreferrer">Comunidad en Discord ↗</a>
        <a href={url("fuentes/")}>
          Fuentes y variantes <span aria-hidden="true">↗</span>
        </a>
      </div>
      <nav class="shell footer-privacidad" aria-label="Privacidad y datos">
        <a href={url("privacidad/")}>Política de privacidad</a>
        <a href={url("eliminacion-de-datos/")}>Eliminación de datos</a>
      </nav>
      <dl class="shell footer-versiones" aria-label="Versiones">
        <div>
          <dt>Interfaz</dt>
          <dd>
            {commit
              ? <a href={`https://github.com/flabat/truco-uruguayo/commit/${commit}`}>{commit.slice(0, 8)}</a>
              : "Sin informar"}
          </dd>
        </div>
        <div>
          <dt>Motor local</dt>
          <dd>{versionMotorPractica}</dd>
        </div>
        <div>
          <dt>Modelo local</dt>
          <dd><FichaModelo id={versionModeloPractica} /></dd>
        </div>
      </dl>
    </footer>
  </body>
</html>
<script>
  import { contar } from "../lib/eventos";
  document.querySelector("[data-discord-comunidad]")?.addEventListener("click", () => contar("discord"));
</script>
<style>
  .footer-privacidad { display: flex; flex-wrap: wrap; gap: 6px 24px; padding-bottom: 16px; color: var(--muted); font-size: 12px; }
  .footer-privacidad a { text-decoration: underline; text-underline-offset: 3px; }
  @media (min-width: 701px) and (max-width: 820px) {
    .masthead-inner, .masthead-inner .site-nav { gap: 12px; }
  }
  @media (max-width: 375px) {
    .masthead-inner .site-nav { gap: 6px; }
  }
</style>
