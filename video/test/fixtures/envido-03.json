{
 "lineas": [
  {
   "id": "pregunta",
   "texto": "¿Cuánto envido cantás con el tres de espadas de muestra?"
  },
  {
   "id": "cartas",
   "texto": "Cinco y siete de oros, y dos de copas. ¿Cuánto te da?",
   "pausa": true
  },
  {
   "id": "respuesta1",
   "texto": "Treinta y dos. Son veinte por los oros, más cinco, más siete. El dos de copas queda afuera."
  },
  {
   "id": "cambio",
   "texto": "Cambiá el cinco de oros por el cinco de espadas. Ahora es pieza. ¿Cuánto cantás?",
   "pausa": true
  },
  {
   "id": "respuesta2",
   "texto": "Treinta y cinco. El cinco de espadas vale veintiocho. Sumale el siete, que vale más que el dos. Los veinte ya están incluidos."
  },
  {
   "id": "tercera",
   "texto": "As de copas, seis de oros y caballo de bastos. Tres palos distintos. Te quedás con el seis. El caballo común vale cero."
  },
  {
   "id": "cierre",
   "texto": "Probá otra mano en El Truco."
  }
 ],
