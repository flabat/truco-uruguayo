{
  "name": "truco-uruguayo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "paquetes/*"
  ],
  "scripts": {
    "dev": "astro dev",
    "arena": "node training/arena/cli.ts",
    "prebuild": "npm run cartas:generar",
    "build": "astro build",
    "test:unit": "node --test \"tests/unit/*.test.ts\"",
    "check": "bash .github/scripts/check_site.sh",
    "check:production": "bash scripts/verificar-produccion.sh",
    "check:stack": "bash scripts/verificar-stack.sh",
    "auth:google": "bash scripts/ingreso-social-local.sh google",
    "auth:discord": "bash scripts/ingreso-social-local.sh discord",
    "auth:facebook": "bash scripts/ingreso-social-local.sh facebook",
    "auth:apple": "bash scripts/ingreso-social-local.sh apple",
    "auth:api": "bash scripts/cliente-api-local.sh",
    "preview": "astro preview",
    "cartas:generar": "node scripts/tatu/generar.mjs",
    "cartas:verificar": "node scripts/tatu/generar.mjs --verificar",
    "cartas:exportar": "node scripts/tatu/generar.mjs --exportar",
    "train": "node training/cli.ts",
    "league": "python3 -B training/selfplay/local.py",
    "reel": "npm --prefix video run reel --",
    "reel:studio": "npm --prefix video run studio --",
    "reel:instalar": "npm ci --prefix video"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@astrojs/react": "7.1.9",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/dm-serif-text": "5.3.0",
    "@tabler/core": "1.7.5",
    "astro": "7.4.12",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@xmldom/xmldom": "0.9.12",
    "sharp": "0.35.5"
  }
}
