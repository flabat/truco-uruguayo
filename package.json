{
  "name": "truco-uruguayo",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "paquetes/*",
    "app"
  ],
  "scripts": {
    "dev": "astro dev",
    "arena": "node training/arena/cli.ts",
    "prebuild": "npm run cartas:generar",
    "build": "astro build",
    "test:unit": "if [ -z \"$CI\" ]; then TEST_CONCURRENCY=${TEST_CONCURRENCY:-2}; fi; node --test ${TEST_CONCURRENCY:+\"--test-concurrency=$TEST_CONCURRENCY\"} \"tests/unit/*.test.ts\" \"paquetes/*/test/*.test.ts\"",
    "app:tipos": "npm --workspace app run tipos",
    "app:exportar": "npm --workspace app run exportar",
    "app:iconos": "node scripts/app-iconos.mjs",
    "app:nativo": "node scripts/app-nativo.ts",
    "app:web": "node scripts/app-web.ts",
    "check": "python3 scripts/cola-pila.py bash .github/scripts/check_site.sh",
    "check:rapido": "node scripts/check-rapido.mjs",
    "check:production": "python3 scripts/cola-pila.py bash scripts/verificar-produccion.sh",
    "check:stack": "python3 scripts/cola-pila.py bash scripts/verificar-stack.sh",
    "auth:google": "bash scripts/ingreso-social-local.sh google",
    "auth:discord": "bash scripts/ingreso-social-local.sh discord",
    "auth:facebook": "bash scripts/ingreso-social-local.sh facebook",
    "auth:apple": "bash scripts/ingreso-social-local.sh apple",
    "auth:api": "bash scripts/cliente-api-local.sh",
    "preview": "astro preview",
    "trabajo": "node scripts/trabajo.mjs",
    "cartas:generar": "node scripts/tatu/generar.mjs",
    "voces:generar": "node scripts/voces/generar.ts",
    "cartas:verificar": "node scripts/tatu/generar.mjs --verificar",
    "cartas:exportar": "node scripts/tatu/generar.mjs --exportar",
    "train": "node training/cli.ts",
    "league": "python3 -B training/selfplay/local.py",
    "reel": "npm --prefix video run reel --",
    "reel:studio": "npm --prefix video run studio --",
    "reel:instalar": "npm ci --prefix video",
    "vps": "python3 -B scripts/vps.py"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@astrojs/react": "7.1.9",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/dm-serif-text": "5.3.0",
    "@tabler/core": "1.7.5",
    "astro": "7.4.12",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@expo/fingerprint": "0.21.10",
    "@playwright/test": "1.65.1",
    "@xmldom/xmldom": "0.9.12",
    "sharp": "0.35.5"
  }
}
