{$SITE_HOST} {
	encode zstd gzip
	handle /api/* {
		reverse_proxy api:3001
	}
	@identidad path /realms/mesa/* /resources/*
	handle @identidad {
		reverse_proxy identidad:8080
	}
	# /jugar/ es la exportación web de la app. Las rutas profundas vuelven a su index.html.
	redir /jugar /jugar/{?query} 308
	handle /jugar/* {
		root * /srv
		header /jugar/_expo/static/* Cache-Control "public, max-age=31536000, immutable" {
			match status 200 206 304
		}
		try_files {path} /jugar/index.html
		file_server
	}
	# Enlaces ya compartidos: la dirección de prueba /app/… y el regreso /volver/?mesa= abren la misma pantalla.
	redir /app /jugar/{?query} 308
	handle_path /app/* {
		redir * /jugar{uri} 308
	}
	@volver path /volver /volver/
	redir @volver /jugar/{?query} 308
	handle {
		root * /srv
		header /_astro/* Cache-Control "public, max-age=31536000, immutable" {
			match status 200 206 304
		}
		file_server
	}
}
