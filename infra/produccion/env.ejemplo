# Copiar a .env en la raíz, con permisos 0600. SITE_HOST es sólo el nombre DNS.
SITE_HOST=
# Generar cada valor por separado con openssl rand -hex 32.
POSTGRES_PASSWORD=
GAME_DB_PASSWORD=
ID_DB_PASSWORD=
KC_ADMIN_PASSWORD=
RESTIC_PASSWORD=

# Repositorio restic externo dedicado. Elegir REST por HTTPS o un bucket S3.
RESTIC_REPOSITORY=
# REST con autenticación HTTP Basic.
RESTIC_REST_USERNAME=
RESTIC_REST_PASSWORD=
# S3, si corresponde.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# Salón y reposición de exhibiciones. Activar por separado en el entorno de ensayo.
SALON_HABILITADO=0
EXHIBICIONES_HABILITADAS=0

# Voz por mesa, opcional. Configurar solo en el entorno privado de la API.
DISCORD_GUILD_ID=
DISCORD_CATEGORY_ID=
DISCORD_BOT_TOKEN=
