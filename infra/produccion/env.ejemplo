# Copiar a .env en la raíz, con permisos 0600. SITE_HOST es sólo el nombre DNS.
SITE_HOST=
# ID de la única cuenta de Keycloak con acceso a /gestion/. Vacío deshabilita el acceso.
GESTION_SUJETO=
# Generar cada valor por separado con openssl rand -hex 32.
POSTGRES_PASSWORD=
GAME_DB_PASSWORD=
ID_DB_PASSWORD=
KC_ADMIN_PASSWORD=
RESTIC_PASSWORD=

# Repositorio restic externo dedicado. Elegir REST por HTTPS o un bucket S3.
RESTIC_REPOSITORY=
# REST con autenticación HTTP Basic.
RESTIC_REST_USERNAME=
RESTIC_REST_PASSWORD=
# S3, si corresponde.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
