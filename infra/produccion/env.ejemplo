# Copiar a .env en la raíz, con permisos 0600. SITE_HOST es sólo el nombre DNS.
SITE_HOST=
# ID de la única cuenta de Keycloak con acceso a /gestion/. Vacío deshabilita el acceso.
GESTION_SUJETO=
# Generar cada valor por separado con openssl rand -hex 32.
POSTGRES_PASSWORD=
GAME_DB_PASSWORD=
ID_DB_PASSWORD=
KC_ADMIN_PASSWORD=
RESTIC_PASSWORD=

# Repositorio restic externo dedicado. Elegir REST por HTTPS o un bucket S3.
RESTIC_REPOSITORY=
# REST con autenticación HTTP Basic.
RESTIC_REST_USERNAME=
RESTIC_REST_PASSWORD=
# S3, si corresponde.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# Salón para cuentas autenticadas y reposición automática de exhibiciones.
SALON_HABILITADO=1
EXHIBICIONES_HABILITADAS=1
# Total objetivo de mesas públicas activas entre personas y exhibiciones (0–10).
EXHIBICIONES_OBJETIVO=6
# Con 1 se pausan los turnos y las altas de exhibiciones.
EXHIBICIONES_PAUSADAS=0

# Voz por mesa, opcional. Configurar solo en el entorno privado de la API.
DISCORD_GUILD_ID=
DISCORD_CATEGORY_ID=
DISCORD_BOT_TOKEN=
# El visor ofrece voz cuando el salón está abierto y Discord está configurado.
VOZ_ESPECTADORA_HABILITADA=1

# Eliminación de cuentas (obligatorio). Secreto del cliente de servicio truco-api (openssl rand -hex 32);
# después de levantar la identidad, registrarlo con npm run auth:api (ver docs/produccion.md).
KEYCLOAK_API_CLIENT_SECRET=
# Sign in with Apple (docs/ingreso-social.md). La API usa la misma clave para revocar tokens.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contenido del archivo .p8, entre comillas para conservar los saltos de línea.
APPLE_PRIVATE_KEY=
# Clave AES de 32 bytes en base64 para guardar los tokens de Apple (openssl rand -base64 32).
APPLE_TOKENS_KEY=

# Enlaces que abren la app (docs en app/README.md). APPLE_TEAM_ID, el de arriba, también firma
# /.well-known/apple-app-site-association. Huellas SHA-256 de los certificados de firma de Android
# (la de Play App Signing y, si hace falta, la de subida), separadas por comas. Vacías: abren la web.
ANDROID_CERT_SHA256=

# Sólo en /etc/truco-oriental/production.env del VPS: 1 publica main sin esperar
# verificado-local ni check.yml (docs/produccion.md).
DESPLIEGUE_SIN_VERIFICAR=
