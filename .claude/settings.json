{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm run check)",
      "Bash(npm run test:unit)",
      "Bash(npm run build)",
      "Bash(npm run cartas:verificar)",
      "Bash(npm exec -- playwright install --only-shell chromium)",
      "Bash(npm exec -- playwright test:*)",
      "Bash(TEST_PORT=* npm run check)",
      "Bash(python3 -B -m unittest discover -s tests/despliegue)",
      "Bash(python3 .github/scripts/check_links.py:*)",
      "Bash(python3 .github/scripts/check_cards.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(git worktree list:*)",
      "Bash(git ls-remote:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)"
    ]
  }
}
